  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.mjs",
    "lint": "oxlint --config .oxlintrc.json src && eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yml}\"",
