{
  "name": "traffic-incident-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:bus": "node scripts/test-bus.mjs",
    "baseline": "node scripts/baseline.mjs",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update",
    "seed": "node scripts/seed.mjs",
    "lint": "node scripts/check-messages.mjs && oxlint --config .oxlintrc.json src && eslint",
    "check:messages": "node scripts/check-messages.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yml}\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-virtual": "^3.14.9",
    "date-fns": "^4.4.0",
    "motion": "^13.0.0",
    "next": "^15.5.0",
    "next-intl": "^4.13.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.2.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
