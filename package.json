{
  "name": "traffic-incident-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json src && eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yml}\""
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
